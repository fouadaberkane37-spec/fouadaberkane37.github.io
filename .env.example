# Copy to .env.local for local development. On Vercel, set these in
# Project → Settings → Environment Variables. Never commit real values.

# --- Required in production -------------------------------------------------

# Anthropic API key (https://platform.claude.com) — used to analyze the 4 photos.
ANTHROPIC_API_KEY=
# Model used for the photo analysis. Default: claude-sonnet-5-5
ANTHROPIC_MODEL=claude-sonnet-5-5

# Make.com custom webhook URL. Receives quote.submitted and quote.accepted events.
MAKE_WEBHOOK_URL=

# Random secret (at least 32 characters) that signs quotes and photo links.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
QUOTE_SIGNING_SECRET=

# Vercel Blob read/write token (created automatically when you add a Blob store to the project).
# Without it, photos are saved to ./.data/uploads (local development only).
BLOB_READ_WRITE_TOKEN=

# Upstash Redis (free tier) for rate limiting across all Vercel instances.
# Without it, limits are kept in memory (local development only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Public (sent to the browser) ------------------------------------------

# Google Maps Platform browser key with "Maps JavaScript API" and "Places API (New)" enabled.
# Restrict it to your domains (HTTP referrers). Used ONLY for address autocomplete.
# Without it, the address step is a plain text field.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Public site URL, used for canonical links and the sitemap.
NEXT_PUBLIC_SITE_URL=https://zfentretien.ca
